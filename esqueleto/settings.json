{
  "permissions": {
    "defaultMode": "acceptEdits",
    "allow": [
      "Read(~/.claude/plugins/**)",
      "Bash(date *)",
      "Bash(sw_vers *)",
      "Bash(uname *)",
      "Bash(xcode-select -p)",
      "Bash(defaults read -g AppleLocale)",
      "Bash(ls /Applications)",
      "Read(//Applications/**)",
      "Bash(python3 --version)",
      "Bash(python3 -m pip show *)",
      "Bash(python3 rotinas/*)",
      "Bash(python3 frentes/*)",
      "Bash(sh rotinas/*)",
      "Bash(sh frentes/*)",
      "PowerShell(Get-Date *)",
      "PowerShell(Get-ChildItem *)",
      "PowerShell(Get-Command *)",
      "PowerShell(Get-Culture *)",
      "PowerShell(python --version)",
      "PowerShell(py --version)",
      "PowerShell(python -m pip show *)",
      "PowerShell(py -m pip show *)",
      "PowerShell(python rotinas*)",
      "PowerShell(python frentes*)",
      "PowerShell(py rotinas*)",
      "PowerShell(py frentes*)",
      "PowerShell(./rotinas*)",
      "PowerShell(./frentes*)",
      "PowerShell(.\\rotinas*)",
      "PowerShell(.\\frentes*)",
      "mcp__business-creator__teste_do_base_camp"
    ],
    "ask": [
      "Bash(rm *)",
      "Bash(curl *)",
      "Bash(wget *)",
      "Bash(git push *)",
      "Bash(pip install *)",
      "Bash(python3 -m pip install *)",
      "PowerShell(Remove-Item *)",
      "PowerShell(Invoke-WebRequest *)",
      "PowerShell(Invoke-RestMethod *)",
      "PowerShell(Send-MailMessage *)",
      "PowerShell(pip install *)",
      "PowerShell(python -m pip install *)",
      "PowerShell(py -m pip install *)"
    ]
  },
  "extraKnownMarketplaces": {
    "sem-ia": {
      "source": {
        "source": "github",
        "repo": "arthurtropia-source/business-creator"
      },
      "autoUpdate": true
    }
  },
  "enabledPlugins": {
    "business-creator@sem-ia": true
  },
  "language": "Portuguese",
  "spinnerVerbs": {
    "mode": "replace",
    "verbs": [
      "Lendo o mapa",
      "Arrumando a mochila",
      "Firmando o passo",
      "Marcando a trilha",
      "Acendendo a lanterna",
      "Conferindo a rota",
      "Montando o acampamento",
      "Abrindo caminho"
    ]
  },
  "spinnerTipsEnabled": false,
  "companyAnnouncements": [
    "Business Creator powered by SEM IA™ · Montagem do Base Camp. Onde todo sistema começa: uma pasta, um arquivo e qualquer IA."
  ]
}
